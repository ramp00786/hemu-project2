# Speech-to-text (Sarvam)
SARVAM_API_KEY=
# Put the exact STT endpoint from your Sarvam account/docs.
SARVAM_STT_URL=

# Optional LLM card (explicit generation on the same retrieved chunks)
GROQ_API_KEY=
GROQ_MODEL=allam-2-7b
# LLM prompt size (smaller = faster). Retrieval top_k can stay higher.
LLM_TOP_K=2
LLM_CHUNK_CHARS=320
LLM_MAX_TOKENS=80
# 1 = show Groq LLM card. 0 = extractive only.
LLM_FALLBACK=1

# Query embedding device for retrieval: auto | cuda | cpu (GPU speeds up retrieve_ms)
EMBED_DEVICE=auto
